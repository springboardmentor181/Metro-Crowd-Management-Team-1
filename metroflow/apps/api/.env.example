# ── MetroFlow API (Doc 17) ──
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase (fill from your project — see chat checklist). Leave blank to run
# the API in CSV-backed dev mode with auth verification disabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
DATABASE_URL=

# Infra (optional in dev)
REDIS_URL=redis://localhost:6379/0

# Replay engine
REPLAY_DEFAULT_SPEED=3600
REPLAY_START_AT=2024-10-01T05:00:00Z

# Groq LLM (MetroBot chatbot). Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
